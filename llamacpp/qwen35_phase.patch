+// kv mode: kq_b[k, q, h] = log(1 - (1 - sp_h)(1 - A[k, q])) / kq_scale,  A = s_q s_k + (1 - s_q)(1 - s_k)
+// (build_attn_mha adds kq_b before the softmax scale, hence the division; a non-null kq_b disables flash attn)
+ggml_tensor * llama_model_qwen35::graph::build_phase_kq_bias(int il, float kq_scale) {
+    GGML_ASSERT(phase_q_pos && phase_kv_pos);
+    const int64_t n_kv = phase_kv_pos->ne[0];
+
+    ggml_tensor * s_q = ggml_reshape_2d(ctx0, build_phase_clock(phase_q_pos,  il), 1, n_tokens);
+    ggml_tensor * s_k = ggml_repeat_4d(ctx0, ggml_reshape_2d(ctx0, build_phase_clock(phase_kv_pos, il), n_kv, 1), n_kv, n_tokens, 1, 1);
+
+    ggml_tensor * A = ggml_add(ctx0,
+            ggml_mul(ctx0, s_k, s_q),
+            ggml_mul(ctx0, ggml_scale_bias(ctx0, s_k, -1.0f, 1.0f), ggml_scale_bias(ctx0, s_q, -1.0f, 1.0f)));
+    cb(A, "phase_same", il);
+
+    ggml_tensor * bias;
+    if (hparams.phase_hard[il]) {
+        bias = ggml_log(ctx0, A); // A in {0, 1} -> {-inf, 0}, shared by all heads
+        bias = ggml_reshape_4d(ctx0, bias, n_kv, n_tokens, 1, 1);
+    } else {
+        const int64_t n_h = hparams.n_head(il);
+        ggml_tensor * x = ggml_repeat_4d(ctx0, ggml_scale_bias(ctx0, A, -1.0f, 1.0f), n_kv, n_tokens, n_h, 1);
+        ggml_tensor * omsp = ggml_reshape_3d(ctx0, ggml_scale_bias(ctx0, model.layers[il].phase_supp, -1.0f, 1.0f), 1, 1, n_h);
+        x = ggml_scale_bias(ctx0, ggml_mul(ctx0, x, omsp), -1.0f, 1.0f);
+        x = ggml_clamp(ctx0, x, 1e-9f, 1.0f);
+        bias = ggml_log(ctx0, x);
+    }
+    bias = ggml_scale(ctx0, bias, 1.0f / kq_scale);
+    cb(bias, "phase_kq_b", il);
+    return bias;
+}
+
+// per-head weight w[h, t] = 1 - (1 - act)(1 - sp_h),  act = g_h s_t + (1 - g_h)(1 - s_t)    -> [n_h, n_tokens]
+ggml_tensor * llama_model_qwen35::graph::build_phase_head_weight(int il, ggml_tensor * grp, ggml_tensor * supp, int64_t n_h) {
+    GGML_ASSERT(phase_q_pos && grp && supp);
+    ggml_tensor * s_q = ggml_reshape_2d(ctx0, build_phase_clock(phase_q_pos, il), 1, n_tokens);
+    ggml_tensor * g   = ggml_repeat_4d(ctx0, ggml_reshape_2d(ctx0, grp, n_h, 1), n_h, n_tokens, 1, 1);
+    ggml_tensor * act = ggml_add(ctx0,
+            ggml_mul(ctx0, g, s_q),
+            ggml_mul(ctx0, ggml_scale_bias(ctx0, g, -1.0f, 1.0f), ggml_scale_bias(ctx0, s_q, -1.0f, 1.0f)));
+    ggml_tensor * omsp = ggml_reshape_2d(ctx0, ggml_scale_bias(ctx0, supp, -1.0f, 1.0f), n_h, 1);
+    return ggml_scale_bias(ctx0, ggml_mul(ctx0, ggml_scale_bias(ctx0, act, -1.0f, 1.0f), omsp), -1.0f, 1.0f);
+}
