+++ b/conversion/qwen35_phase.py
@@ -0,0 +1,104 @@
+"""qwen35_phase: Qwen3.5/3.6/3.8 dense hybrid + phase attention (antmikinka/phase-attention, qwen38/).
+
+Input directory = a normal Qwen3_5ForCausalLM HF directory whose config.json has
+  "architectures": ["Qwen3_5PhaseForCausalLM"] and a "phase_config" dict
+    {"layers": {"<il>": {"mode": "kv"|"head"|null, "hard": bool, "period": P, "sharp": k, "offset": phi,
+                         "delta_write": bool}}, ...}
+plus a `phase.safetensors` file with tensors
+  model.layers.<il>.phase.supp        [n_head]    (sp_h, already exp'ed and clamped <= 1)
+  model.layers.<il>.phase.write_supp  [n_v_heads] (HF grouped v-head order; reordered here like ssm_beta)
+  model.layers.<il>.phase.write_grp   [n_v_heads]
+  model.layers.<il>.phase.{feedback,tracking}.{down,up,lam}  (only accepted at strength 0: lam == 0)
+"""
+from __future__ import annotations
+
+import json
+from typing import Iterable, TYPE_CHECKING
+
+import torch
+
+from .base import ModelBase, gguf, logger
+from .qwen import Qwen3_5TextModel
+
+if TYPE_CHECKING:
+    from torch import Tensor
+
+_MODES = {None: 0, "none": 0, "kv": 1, "head": 2}
+
+
+@ModelBase.register("Qwen3_5PhaseForCausalLM")
+class Qwen35PhaseModel(Qwen3_5TextModel):
+    model_arch = gguf.MODEL_ARCH.QWEN35_PHASE
+
+    def __init__(self, dir_model, *args, **kwargs):
+        super().__init__(dir_model, *args, **kwargs)
+        self.phase_cfg = self.hparams.get("phase_config") or {}
+        path = self.dir_model / "phase.safetensors"
+        self.phase_tensors: dict[str, Tensor] = {}
+        if path.is_file():
+            from safetensors.torch import load_file
+            self.phase_tensors = load_file(str(path))
+
+    def set_gguf_parameters(self):
+        super().set_gguf_parameters()
+        n = self.block_count
+        layers = {int(k): v for k, v in (self.phase_cfg.get("layers") or {}).items()}
+        mode  = [0] * n
+        hard  = [0] * n
+        dw    = [0] * n
+        per   = [0.0] * n
+        sharp = [0.0] * n
+        off   = [0.0] * n
+        for il, c in layers.items():
+            mode[il]  = _MODES[c.get("mode")]
+            hard[il]  = int(bool(c.get("hard", False)))
+            dw[il]    = int(bool(c.get("delta_write", False)))
+            per[il]   = float(c.get("period", 0.0))
+            sharp[il] = float(c.get("sharp", 0.0)) if c.get("sharp", 0.0) != float("inf") else 0.0
+            off[il]   = float(c.get("offset", 0.0))
+        arch = self.gguf_writer.arch
+        K = gguf.Keys.Phase
+        self.gguf_writer.add_array(K.MODE.format(arch=arch), mode)
+        self.gguf_writer.add_array(K.HARD.format(arch=arch), hard)
+        self.gguf_writer.add_array(K.DELTA_WRITE.format(arch=arch), dw)
+        self.gguf_writer.add_array(K.PERIOD.format(arch=arch), per)
+        self.gguf_writer.add_array(K.SHARPNESS.format(arch=arch), sharp)
+        self.gguf_writer.add_array(K.OFFSET.format(arch=arch), off)
+        # tracking / feedback are not implemented in llama.cpp: only strength 0 (lam == 0) can be exported
+        for name, t in self.phase_tensors.items():
+            if name.endswith(".lam") and float(t.abs().max()) != 0.0:
+                raise NotImplementedError(f"{name} != 0: tracking/feedback are not implemented in llama.cpp yet")
+        self.gguf_writer.add_uint32(K.FEEDBACK_RANK.format(arch=arch), 0)
+        self.gguf_writer.add_uint32(K.TRACKING_RANK.format(arch=arch), 0)
+
+    def generate_extra_tensors(self) -> Iterable[tuple[str, Tensor]]:
+        layers = {int(k): v for k, v in (self.phase_cfg.get("layers") or {}).items()}
+        n_head = self.hparams["num_attention_heads"]
+        for il, c in layers.items():
+            if c.get("mode") == "head":
+                yield f"model.layers.{il}.phase.hgrp", (torch.arange(n_head) % 2).float()
+        for name, t in self.phase_tensors.items():
+            if ".feedback." in name or ".tracking." in name:
+                logger.info(f"skipping {name} (strength 0, not implemented in llama.cpp)")
+                continue
+            yield name, t.float()
+
+    def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:
+        if ".phase." not in name:
+            yield from super().modify_tensors(data_torch, name, bid)
+            return
+        assert bid is not None
+        kind = name.rsplit(".phase.", 1)[1]
+        if kind in ("write_supp", "write_grp"):
+            # same V-head reorder (grouped -> tiled) as ssm_beta / ssm_alpha rows
+            nk = self.hparams["linear_num_key_heads"]
+            nv = self.hparams["linear_num_value_heads"]
+            if nk != nv:
+                data_torch = self._reorder_v_heads(data_torch.unsqueeze(-1), 0, nk, nv // nk, 1).squeeze(-1)
+        tensor = {
+            "supp":       gguf.MODEL_TENSOR.PHASE_SUPP,
+            "hgrp":       gguf.MODEL_TENSOR.PHASE_HGRP,
+            "write_supp": gguf.MODEL_TENSOR.PHASE_WSUPP,
+            "write_grp":  gguf.MODEL_TENSOR.PHASE_WGRP,
+        }[kind]
+        yield gguf.TENSOR_NAMES[tensor].format(bid=bid), data_torch.float().contiguous()
